#!/usr/bin/bash
# systemd-sleep hook (Surface Pro 11): log the exact battery drain and the wake-up source of every sleep.
# Installed as /usr/lib/systemd/system-sleep/sp11-sleep-log. Output: journalctl -t sp11-sleep
# Remove: sudo rm /usr/lib/systemd/system-sleep/sp11-sleep-log
B=/sys/class/power_supply/qcom-battmgr-bat
S=/run/sp11-sleep-log
case "$1" in
  pre)
    printf '%s %s\n' "$(date +%s)" "$(cat "$B/energy_now" 2>/dev/null)" > "$S"
    ;;
  post)
    read -r t0 e0 < "$S" 2>/dev/null || exit 0
    irq=$(cat /sys/power/pm_wakeup_irq 2>/dev/null)          # read before anything else can overwrite it
    src=""
    [ -n "$irq" ] && src=$(awk -v i="$irq:" '$1 == i {print $NF}' /proc/interrupts)
    sleep 5                                                    # let the battery gauge settle after resume
    t1=$(date +%s); e1=$(cat "$B/energy_now" 2>/dev/null)
    ac=$(cat /sys/class/power_supply/qcom-battmgr-ac/online 2>/dev/null)
    awk -v t0="$t0" -v t1="$t1" -v e0="$e0" -v e1="$e1" -v irq="${irq:-?}" -v src="${src:-?}" \
        -v ac="${ac:-?}" -v mode="${2:-?}" 'BEGIN {
      h = (t1 - t0) / 3600; wh = (e0 - e1) / 1e6
      printf "slept %.2f h (%s), %.3f Wh used, avg %.3f W, battery %.2f -> %.2f Wh, AC=%s, woken by IRQ %s (%s)\n",
             h, mode, wh, (h > 0 ? wh / h : 0), e0 / 1e6, e1 / 1e6, ac, irq, src
    }' | logger -t sp11-sleep
    rm -f "$S"
    ;;
esac
exit 0
